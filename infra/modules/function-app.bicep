targetScope = 'resourceGroup'

@description('func-g4k-<app>. The resource group scopes the name; the default host name carries a tenant-unique hash.')
param name string
param location string
param tags object
@allowed([512, 2048, 4096])
param memoryMb int
@minValue(1)
param maxInstances int
@description('The one origin platform CORS allows: the site that calls this app.')
param allowedOrigin string
@description('The account that holds the code package and the Functions host state. It holds no game data.')
param hostStorageName string
param appSettings object
@description('Empty gives the app its own system-assigned identity. Otherwise the app runs as this user-assigned identity.')
param userAssignedIdentityId string = ''
param userAssignedClientId string = ''
param userAssignedPrincipalId string = ''
param deployPrincipalId string
param deployIdentityId string

var runsAsUserAssigned = !empty(userAssignedIdentityId)
var blobDataOwner = 'b7e6dc6d-f1e8-4753-8033-0f276bb0955b'
var queueDataContributor = '974c5e8b-45b9-4653-ba55-5f855dd0fb88'
var tableDataContributor = '0a9a7e1f-b9d0-4cc4-a60d-0319b160aaa3'
var websiteContributor = 'de139f84-1756-47ae-9be6-808fbbe84772'
var hostRoles = [blobDataOwner, queueDataContributor, tableDataContributor]

resource host 'Microsoft.Storage/storageAccounts@2023-05-01' existing = {
  name: hostStorageName
}

resource hostBlobs 'Microsoft.Storage/storageAccounts/blobServices@2023-05-01' existing = {
  parent: host
  name: 'default'
}

resource deployContainer 'Microsoft.Storage/storageAccounts/blobServices/containers@2023-05-01' = {
  parent: hostBlobs
  name: 'deploy-${name}'
}

resource plan 'Microsoft.Web/serverfarms@2024-04-01' = {
  name: 'plan-${name}'
  location: location
  tags: tags
  kind: 'functionapp'
  sku: {
    name: 'FC1'
    tier: 'FlexConsumption'
  }
  properties: { reserved: true }
}

resource app 'Microsoft.Web/sites@2024-04-01' = {
  name: name
  location: location
  tags: tags
  kind: 'functionapp,linux'
  identity: runsAsUserAssigned ? {
    type: 'UserAssigned'
    userAssignedIdentities: { '${userAssignedIdentityId}': {} }
  } : {
    type: 'SystemAssigned'
  }
  properties: {
    serverFarmId: plan.id
    httpsOnly: true
    autoGeneratedDomainNameLabelScope: 'TenantReuse'
    siteConfig: {
      minTlsVersion: '1.2'
      ftpsState: 'Disabled'
      cors: {
        allowedOrigins: [allowedOrigin]
        supportCredentials: false
      }
    }
    functionAppConfig: {
      deployment: {
        storage: {
          type: 'blobContainer'
          value: '${host.properties.primaryEndpoints.blob}${deployContainer.name}'
          authentication: runsAsUserAssigned ? {
            type: 'UserAssignedIdentity'
            userAssignedIdentityResourceId: userAssignedIdentityId
          } : {
            type: 'SystemAssignedIdentity'
          }
        }
      }
      runtime: {
        name: 'node'
        version: '22'
      }
      scaleAndConcurrency: {
        instanceMemoryMB: memoryMb
        maximumInstanceCount: maxInstances
      }
    }
  }
}

var identitySettings = runsAsUserAssigned ? {
  AZURE_CLIENT_ID: userAssignedClientId
  AzureWebJobsStorage__credential: 'managedidentity'
  AzureWebJobsStorage__clientId: userAssignedClientId
} : {}

resource settings 'Microsoft.Web/sites/config@2024-04-01' = {
  parent: app
  name: 'appsettings'
  properties: union({ AzureWebJobsStorage__accountName: host.name }, identitySettings, appSettings)
}

resource hostAccess 'Microsoft.Authorization/roleAssignments@2022-04-01' = [for role in hostRoles: {
  scope: host
  name: guid(host.id, app.id, role)
  properties: {
    principalId: runsAsUserAssigned ? userAssignedPrincipalId : app.identity.principalId
    principalType: 'ServicePrincipal'
    roleDefinitionId: subscriptionResourceId('Microsoft.Authorization/roleDefinitions', role)
  }
}]

resource deployerAccess 'Microsoft.Authorization/roleAssignments@2022-04-01' = {
  scope: app
  name: guid(app.id, deployIdentityId, websiteContributor)
  properties: {
    principalId: deployPrincipalId
    principalType: 'ServicePrincipal'
    roleDefinitionId: subscriptionResourceId('Microsoft.Authorization/roleDefinitions', websiteContributor)
  }
}

output id string = app.id
output name string = app.name
output defaultHostName string = app.properties.defaultHostName
output principalId string = runsAsUserAssigned ? userAssignedPrincipalId : app.identity.principalId
