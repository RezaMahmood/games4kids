{
	"name": "games4kids",
	"private": true,
	"type": "module",
	"engines": {
		"node": ">=22.18"
	},
	"workspaces": [
		"packages/sdk",
		"packages/host"
	],
	"scripts": {
		"gen": "node --conditions=source tools/gen.mjs",
		"predev": "npm run gen",
		"prebuild": "npm run gen",
		"build": "tsc -b",
		"pretest": "npm run gen",
		"test": "node --conditions=source --test \"test/**/*.test.ts\"",
		"lint": "eslint ."
	},
	"devDependencies": {
		"@eslint/js": "10.0.1",
		"@types/node": "22.20.5",
		"eslint": "10.13.0",
		"typescript": "6.0.3",
		"typescript-eslint": "8.72.0"
	}
}
